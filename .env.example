# Copier en .env et renseigner vos clés — NE JAMAIS COMMITER LE .env

# Google Search Console (fallback scripts/gsc_query.py quand le MCP GSC est indisponible)
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=

# APIs SEO (selon les agents utilisés)
HALOSCAN_API_KEY=
SEOQUANTUM_API_KEY=
SCRAPINGBEE_API_KEY=
ISINDEXED_API_KEY=
PAGESPEED_API_KEY=
SEOBSERVER_KEY=

# Push WordPress (/seo-content-refresh) — App Password, jamais le mot de passe principal
WP_USER=
WP_APP_PASSWORD=
